<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below (allowBackup="false" already disables backup there);
     kept explicit so the intent survives a future allowBackup change. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
